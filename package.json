{
  "name": "sexy-anime-reviews",
  "version": "1.3.1",
  "description": "Simple app to display my anime reviews. Site: http://animereviews.link",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "start": "npm run build && .venv/bin/python3 main.py",
    "deploy": "npm run build && gcloud app deploy --project=sexy-anime-reviews",
    "bump:patch": "npm version patch",
    "bump:minor": "npm version minor",
    "bump:major": "npm version major",
    "histogram": ".venv/bin/python3 rating_histogram.py",
    "find-orphans": ".venv/bin/python3 find_orphaned_images.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broken/sexy-anime-reviews.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/broken/sexy-anime-reviews/issues"
  },
  "homepage": "https://github.com/broken/sexy-anime-reviews#readme",
  "dependencies": {
    "firebase": "^13.1.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
